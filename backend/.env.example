# App
SECRET_KEY=yoursecretkey_min_32_characters_long_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/autofinetune

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=autofinetune-datasets
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
VERTEX_STAGING_BUCKET=gs://autofinetune-staging

# Limits
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MODELS=gemini-1.0-pro-002
